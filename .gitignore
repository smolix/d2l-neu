.upload-manifest-*.txt

# Top-level rendered PDF (a build artifact, regenerated by the make targets)
/index.pdf

# Build logs
logs/

# Shared download cache for notebook datasets
/data/

# Extracted output images from notebook execution
img/outputs/

# Quarto intermediates
*.tex
!tools/beamer/*.tex
# ...but static/d2l-preamble.tex is a hand-written SOURCE file (the PDF
