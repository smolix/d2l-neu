run_one.sh

# incremental `make figures` per-generator stamps
.figstamps/

# torch.compile / Triton caches (make/notebooks.mk EXTRA_ENV_pytorch)
.cache/

# UI-string includes and the 404 page, rendered from i18n/en.yml (tools/i18n.py)
/_i18n/
/404.qmd

